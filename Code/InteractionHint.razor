@using Sandbox;
@inherits PanelComponent

<root style="position: absolute; width: 100%; height: 100%; pointer-events: none;">
	
    @* --- DEBUG MENU: DELETE THIS LATER --- *@
    <div style="position: absolute; top: 200px; left: 50px; color: yellow; font-size: 24px; font-weight: bold; background-color: rgba(0,0,0,0.5); padding: 10px;">
        DEBUG MODE <br>
        1. UI Loaded: YES <br>
        2. Found Player Script: @(MyInteractor != null ? "YES" : "NO") <br>
        3. Sees Object: @(MyInteractor?.CurrentInteractable?.ActionName ?? "None")
    </div>
    @* ------------------------------------- *@

    @if ( MyInteractor != null && MyInteractor.CurrentInteractable != null )
    {
        <div class="hint-box">
             <div class="key">E</div>
             <div class="label">@MyInteractor.CurrentInteractable.ActionName</div>
        </div>
    }
</root>

@code {
    [Property] public PlayerInteractor MyInteractor { get; set; }

    protected override void OnUpdate()
    {
        // FIX: If the slot is empty, search parents to find the player automatically
        if ( MyInteractor == null )
        {
            MyInteractor = Components.GetInAncestors<PlayerInteractor>();
        }
    }

    // Tells the UI to redraw when the target changes
	protected override int BuildHash() => System.HashCode.Combine( MyInteractor?.CurrentInteractable );
}