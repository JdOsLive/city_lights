@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<!-- 
    PLAYER NAME TAG WITH AVATAR
    Style: Navy Blue & Gold (Premium)
-->

<style>
	.nametag-panel {
		/* Flex row to put image next to text */
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 20px 10px 16px;
		background-color: rgba(10, 25, 50, 0.9);
		border-radius: 50px;
		width: auto;
		justify-content: center;
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		opacity: 1;
		transition: opacity 0.2s;
		border: 1px solid rgba(255, 215, 0, 0.3);
		box-shadow:
			0 8px 20px rgba(0, 0, 0, 0.45),
			0 2px 8px rgba(0, 0, 0, 0.30);

	}

	.steam-username {
		font-family: "Poppins", sans-serif;
		font-weight: 700;
		font-size: 32px;
		color: white;
		text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
		white-space: nowrap;
		overflow: visible;
		text-overflow: clip;
	}

	.steam-profile-picture {
		padding-right: 4px;
	}

	.steam-profile-picture img {
		width: 64px;
		height: 64px;
		border-radius: 50px;
		border: 1px solid rgba(255, 215, 0, 0.3);
	}
	/* --- SELF HIGHLIGHT (GOLD) --- */
	@* .self .name-text {
		color: #FFD700; /* Gold */
		text-shadow: 0 0 10px rgba(255, 215, 0, 0.4); /* Gold Glow */
	}
	
	.self .avatar {
		border-color: #FFD700;
		box-shadow: 0 0 10px rgba(255, 215, 0, 0.4); /* Avatar Glow */
	}
	
	.self.nametag-panel {
		border-color: rgba(255, 215, 0, 0.6);
	}  *@
</style>

<root>
	<!-- FIX: Only render if NOT local (or if we really want to debug self tags) -->
	@if ( !IsLocal )
	{
		<div class="nametag-panel" style="opacity: @Opacity">
			<!-- Avatar Image using URL scheme -->
			<div class="steam-profile-picture"> 
				<img	 src=@AvatarUrl />
			</div>
		
			<!-- Name Text -->
			<div class="steam-username">@Name</div>
		</div>
	}
</root>

@code {
	public string Name { get; set; } = "";
	public bool IsLocal { get; set; } = false;
	public float Opacity { get; set; } = 1.0f;
	public string AvatarUrl { get; set; } = "";

	private ulong _currentSteamId = 0;

	protected override void OnUpdate()
	{
		var net = GameObject.Network;
		
		if ( net != null && net.Active )
		{
			var owner = net.Owner;
			
			if ( owner != null )
			{
				Name = owner.DisplayName;
				IsLocal = (owner == Connection.Local);

				// Update Avatar URL if the user changed
				if ( _currentSteamId != owner.SteamId )
				{
					_currentSteamId = owner.SteamId;
					// Use the UI URL scheme for avatars
					AvatarUrl = $"avatar:{owner.SteamId}";
				}
			}
			else
			{
				Name = "Player";
				_currentSteamId = 0;
				AvatarUrl = "";
			}
		}
		else
		{
			Name = "";
		}

		if ( Scene.Camera != null )
		{
			var dist = WorldPosition.Distance( Scene.Camera.WorldPosition );
			
			if ( dist > 500 ) Opacity = 0;
			else if ( dist > 300 ) Opacity = 1.0f - ((dist - 300) / 200);
			else Opacity = 1.0f;
		}
	}

	protected override int BuildHash() => System.HashCode.Combine( Name, Opacity, _currentSteamId, IsLocal );
}
